<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %>
  </title>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" href="/favicon.svg" />

</head>

<body>
  <header>Message board</header>
  <div class="top">
    <h1>Messages</h1>
    <a href="/new" class="button-class">
      Add message</a>
  </div>
  <ul>
    <% messages.map((message)=> { %>
      <li>
        <div id=<%=message.id %> class="message_item">
          <p>Posted by: <strong>
              <%= message.username %>
            </strong> at <%= message.added.toDateString() %>:<br>
              > <%= message.message %>
          </p>
          <button onclick="goToDetails(event)">Details</button>
          <button onclick="deleteNote(event)">Delete</button>
        </div>
      </li>
      <% }) %>
  </ul>

  <script>
    function goToDetails(e) {
      window.location.href = "/details/" + e.target.parentElement.id;
    }

    function deleteNote(e) {
      window.location.href = "/delete/" + e.target.parentElement.id;
    }
  </script>
</body>

</html>